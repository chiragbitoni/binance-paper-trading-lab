[Unit]
Description=Binance Paper Lab local dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/binance-paper-trading-lab
ExecStart=/opt/binance-paper-trading-lab/.venv/bin/python run.py dashboard
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
